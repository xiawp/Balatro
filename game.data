PROD_PC_Console-- Browser compatibility layer for the LÃ–VE 11.5 / WebAssembly target.
-- Loaded only in the web build; the native build keeps its original behaviour.

local WEB = rawget(_G, '_WEB_BUILD') == true
local M = {}

if not WEB then
    function M.install_game_patches() end
    return M
end

-- Lua builds used by WebAssembly can expose math.log(x) only. Balatro uses
-- math.log(x, base) in a few UI/score calculations.
do
    local native_log = math.log
    math.log = function(value, base)
        if base ~= nil then
            return native_log(value) / native_log(base)
        end
        return native_log(value)
    end
end

-- Keep integer seeds identical to desktop. Convert fractional seeds to a
-- stable integer because some WebAssembly Lua builds reject fractional seeds.
do
    local native_randomseed = math.randomseed
    local MOD = 2147483647
    math.randomseed = function(seed)
        seed = tonumber(seed) or os.time()
        if seed % 1 ~= 0 then
            local whole = math.floor(seed)
            local fraction = seed - whole
            seed = (whole % MOD + math.floor(fraction * (MOD - 1)) * 48271) % MOD
        end
        return native_randomseed(seed)
    end
end

-- love.js runs the game on one browser thread. Emulate LÃ–VE channels and
-- worker threads with Lua coroutines: each worker yields while waiting on a
-- channel, and resumes immediately when a message is pushed to that channel.
do
    local channels = {}
    local last_created_thread = nil
    local active_thread = nil
    local anonymous_channel_id = 0

    local function resume_worker(worker, ...)
        if not worker or not worker.started or worker.running then return end
        if coroutine.status(worker.coroutine) ~= 'suspended' then return end

        local previous = active_thread
        active_thread = worker
        worker.running = true
        local ok, result = coroutine.resume(worker.coroutine, ...)
        worker.running = false
        active_thread = previous

        if not ok then
            error('Web worker error (' .. tostring(worker.name) .. '): ' .. tostring(result), 0)
        end
        return result
    end

    local Channel = {}
    Channel.__index = Channel

    function Channel:push(value)
        self.queue[#self.queue + 1] = value
        if self.owner and self.owner ~= active_thread then
            resume_worker(self.owner)
        end
        return true
    end

    function Channel:supply(value)
        return self:push(value)
    end

    function Channel:pop()
        if #self.queue == 0 then return nil end
        return table.remove(self.queue, 1)
    end

    function Channel:demand()
        while #self.queue == 0 do
            coroutine.yield()
        end
        return table.remove(self.queue, 1)
    end

    function Channel:peek()
        return self.queue[1]
    end

    function Channel:getCount()
        return #self.queue
    end

    function Channel:clear()
        self.queue = {}
    end

    function Channel:performAtomic(callback, ...)
        if type(callback) == 'function' then
            return callback(...)
        end
    end

    local Thread = {}
    Thread.__index = Thread

    function Thread:start(...)
        if self.started then return false, 'Thread already started' end
        self.started = true
        return resume_worker(self, ...)
    end

    function Thread:isRunning()
        return self.running == true
    end

    function Thread:getError()
        return self.error
    end

    function Thread:wait()
        return nil
    end

    local thread_api = {}

    function thread_api.getChannel(name)
        name = tostring(name or 'unnamed')
        if not channels[name] then
            channels[name] = setmetatable({
                name = name,
                queue = {},
                owner = active_thread or last_created_thread,
            }, Channel)
        elseif not channels[name].owner then
            channels[name].owner = active_thread or last_created_thread
        end
        return channels[name]
    end

    function thread_api.newChannel()
        anonymous_channel_id = anonymous_channel_id + 1
        local name = 'anonymous_' .. tostring(anonymous_channel_id)
        return thread_api.getChannel(name)
    end

    function thread_api.newThread(path_or_source)
        local source, name
        if type(path_or_source) == 'string' then
            name = path_or_source
            source = love.filesystem.read(path_or_source)
            if not source then
                error('Cannot read web worker source: ' .. path_or_source, 2)
            end
        else
            error('Web worker expects a Lua source path', 2)
        end

        local loader = loadstring or load
        local chunk, load_error = loader(source, '@' .. name)
        if not chunk then error(load_error, 2) end

        local worker = setmetatable({
            name = name,
            coroutine = coroutine.create(chunk),
            started = false,
            running = false,
            error = nil,
        }, Thread)
        last_created_thread = worker
        return worker
    end

    love.thread = thread_api
    package.preload = package.preload or {}
    package.preload['love.thread'] = function() return love.thread end
    package.loaded = package.loaded or {}
    package.loaded['love.thread'] = love.thread
end

-- WebGL does not need desktop-style mipmap chains for these pixel-art atlases.
-- Disabling mipmaps avoids driver-specific mipmap allocation/format issues.
if love.graphics and love.graphics.newImage then
    local native_new_image = love.graphics.newImage
    love.graphics.newImage = function(image, flags)
        if type(flags) == 'table' then
            flags.mipmaps = false
        end
        local result = native_new_image(image, flags)
        local mt = getmetatable(result)
        if mt and type(mt.__index) == 'table' then
            mt.__index.setMipmapFilter = mt.__index.setMipmapFilter or function() end
        end
        return result
    end
end

-- Avoid asking the browser to switch native window modes. The canvas is sized
-- by CSS and the LOVE resize callback keeps the game viewport in sync.
if love.window then
    love.window.getDisplayCount = function() return 1 end
    love.window.getDesktopDimensions = function()
        if love.graphics and love.graphics.getDimensions then
            return love.graphics.getDimensions()
        end
        return 1280, 720
    end
    love.window.getFullscreenModes = function()
        local width, height = love.window.getDesktopDimensions()
        return {{width = width, height = height}}
    end
    love.window.updateMode = function()
        if love.graphics and love.graphics.getDimensions and love.resize then
            local width, height = love.graphics.getDimensions()
            love.resize(width, height)
        end
        return true
    end
end

function M.install_game_patches()
    if M._installed then return end
    M._installed = true

    -- The browser has one canvas/display and no desktop resolution chooser.
    if G and G.FUNCS and G.FUNCS.apply_window_changes then
        G.FUNCS.apply_window_changes = function(initial)
            G.SETTINGS.WINDOW.screenmode = 'Windowed'
            G.SETTINGS.WINDOW.selected_display = 1
            G.SETTINGS.WINDOW.display_names = {'Browser'}
            G.SETTINGS.WINDOW.DISPLAYS = G.SETTINGS.WINDOW.DISPLAYS or {}
            G.SETTINGS.WINDOW.DISPLAYS[1] = G.SETTINGS.WINDOW.DISPLAYS[1] or {}
            local width, height = love.graphics.getDimensions()
            G.SETTINGS.WINDOW.DISPLAYS[1].screen_res = {w = width, h = height}
            G.SETTINGS.WINDOW.DISPLAYS[1].screen_resolutions = {
                strings = {'Browser'},
                values = {{w = width, h = height}},
            }
            G.SETTINGS.QUEUED_CHANGE = {}
            if love.resize then love.resize(width, height) end
            if initial ~= true and G.save_settings then G:save_settings() end
        end
    end

    if G then
        G.F_HTTP_SCORES = false
        G.F_CRASH_REPORTS = false
        G.F_RUMBLE = nil
        G.F_VIDEO_SETTINGS = false
        G.F_VERBOSE = false
    end
end

return M
