                })
                G.booster_pack_meteors = Particles(1, 1, 0,0, {
                    timer = 2,
                    scale = 0.05,
                    lifespan = 1.5,
                    speed = 4,
                    attach = G.ROOM_ATTACH,
                    colours = {G.C.WHITE},
                    fill = true
                })
                G.booster_pack = UIBox{
                    definition = create_UIBox_celestial_pack(), 
                    config = {
                        align="tmi",
